```gitignore
# Excel files
*.xlsx

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment files
.env
.env.local
*.env.*

# Logs
*.log

# Temporary files
*.tmp
*.temp
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
.coverage
coverage/
htmlcov/

# IDE specific
.vscode/
.idea/
*.swp
*.swo
```